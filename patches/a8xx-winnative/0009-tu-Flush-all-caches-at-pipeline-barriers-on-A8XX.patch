From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: durunduk <drebdebian@gmail.com>
Date: Mon, 19 Oct 2026 02:30:00 +0300
Subject: [PATCH] tu: Flush all caches at pipeline barriers on A8XX

Styx: Blades of Greed (UE 5.6, vkd3d-proton 0bb64c56, Adreno 840)
renders shattered geometry on its second level. TU_DEBUG=flushall fixes
it, and so does a full clean + invalidate at pipeline barriers only, so
the barrier-to-flush mapping misses something on A8XX. Do that full
flush at every barrier on A8XX by default until the exact cache is
known; it is much cheaper than flushall.

TU_FLUSH_HACK=<items> overrides it (comma separated):
  barrier   flush at pipeline barriers
  draw      flush at every draw and dispatch instead
  bindless, uche, ccu, cche, wait
            only these parts (default: everything flushall does)
  none      upstream behaviour
e.g. TU_FLUSH_HACK=uche flushes only UCHE at barriers.
---
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ea1cecd..28fe066 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -354,6 +354,84 @@ tu_emit_rt_workaround(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
    tu_cs_emit(cs, A6XX_CP_SET_MARKER_0_RT_WA_END);
 }
 
+/* WinNative: on A8XX some cache is left stale across pipeline barriers:
+ * Styx: Blades of Greed (UE 5.6, vkd3d-proton) renders shattered geometry
+ * unless every cache is cleaned and invalidated at each barrier. Until the
+ * exact barrier mapping is fixed, A8XX does that by default.
+ *
+ * TU_FLUSH_HACK=<items> overrides the default (comma separated):
+ *   barrier   flush at pipeline barriers (default on A8XX)
+ *   draw      flush at every draw and dispatch instead (like flushall)
+ *   bindless, uche, ccu, cche, wait
+ *             restrict the flush to these parts (default: all of them)
+ *   none      no extra flushes, upstream behaviour
+ */
+struct tu_flush_hack {
+   bool set;          /* TU_FLUSH_HACK given */
+   bool at_barrier;
+   bool at_draw;
+   uint32_t bits;
+};
+
+static struct tu_flush_hack
+tu_flush_hack_parse(void)
+{
+   struct tu_flush_hack h = {};
+   const char *s = getenv("TU_FLUSH_HACK");
+   if (!s || !*s)
+      return h;
+   h.set = true;
+   if (strstr(s, "none"))
+      return h;
+   h.at_barrier = strstr(s, "barrier") != NULL;
+   h.at_draw = strstr(s, "draw") != NULL || strstr(s, "all") != NULL;
+   if (strstr(s, "bindless"))
+      h.bits |= TU_CMD_FLAG_BINDLESS_DESCRIPTOR_INVALIDATE;
+   if (strstr(s, "uche"))
+      h.bits |= TU_CMD_FLAG_CACHE_CLEAN | TU_CMD_FLAG_CACHE_INVALIDATE;
+   if (strstr(s, "ccu"))
+      h.bits |= TU_CMD_FLAG_CCU_CLEAN_COLOR | TU_CMD_FLAG_CCU_CLEAN_DEPTH |
+                TU_CMD_FLAG_CCU_INVALIDATE_COLOR | TU_CMD_FLAG_CCU_INVALIDATE_DEPTH;
+   if (strstr(s, "cche"))
+      h.bits |= TU_CMD_FLAG_CCHE_INVALIDATE;
+   if (strstr(s, "wait"))
+      h.bits |= TU_CMD_FLAG_WAIT_MEM_WRITES | TU_CMD_FLAG_WAIT_FOR_ME;
+   if (!h.bits)
+      h.bits = TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+   /* Only parts named: apply them at barriers. */
+   if (!h.at_barrier && !h.at_draw)
+      h.at_barrier = true;
+   return h;
+}
+
+static const struct tu_flush_hack &
+tu_flush_hack_get(void)
+{
+   /* Function-local static: initialised once, thread-safe in C++11. */
+   static const struct tu_flush_hack h = tu_flush_hack_parse();
+   return h;
+}
+
+/* Extra flush bits for every draw/dispatch flush point. */
+static inline uint32_t
+tu_flush_hack_draw_bits(void)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   return h.at_draw ? h.bits : 0;
+}
+
+/* Extra flush bits for a pipeline barrier. */
+static inline uint32_t
+tu_flush_hack_barrier_bits(const struct tu_cmd_buffer *cmd)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   if (h.set)
+      return h.at_barrier ? h.bits : 0;
+   if (cmd->device->physical_device->info->chip >= A8XX)
+      return TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+   return 0;
+}
+
 template <chip CHIP>
 static void
 tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
@@ -366,6 +444,8 @@ tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
    if (TU_DEBUG(FLUSHALL))
       flushes |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
 
+   flushes |= (enum tu_cmd_flush_bits) tu_flush_hack_draw_bits();
+
    if (TU_DEBUG(SYNCDRAW))
       flushes |= TU_CMD_FLAG_WAIT_MEM_WRITES |
                  TU_CMD_FLAG_WAIT_FOR_IDLE |
@@ -629,7 +709,7 @@ void
 tu_emit_cache_flush_renderpass(struct tu_cmd_buffer *cmd_buffer)
 {
    if (!cmd_buffer->state.renderpass_cache.flush_bits &&
-       likely(!tu_env.debug))
+       likely(!tu_env.debug) && likely(!tu_flush_hack_draw_bits()))
       return;
 
    struct tu_cs *cs = &cmd_buffer->draw_cs;
@@ -10966,6 +11046,9 @@ tu_barrier(struct tu_cmd_buffer *cmd,
 
    TU_CALLX(cmd->device, tu_flush_for_access)(cache, src_flags, dst_flags);
 
+   cache->flush_bits |=
+      (enum tu_cmd_flush_bits) tu_flush_hack_barrier_bits(cmd);
+
    if (!no_sync) {
       enum tu_stage src_stage = vk2tu_src_stage(cmd->device, srcStage);
       enum tu_stage dst_stage = vk2tu_dst_stage(cmd->device, dstStage);
