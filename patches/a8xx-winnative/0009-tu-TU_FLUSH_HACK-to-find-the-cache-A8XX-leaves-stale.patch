From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: durunduk <drebdebian@gmail.com>
Date: Mon, 19 Oct 2026 02:10:00 +0300
Subject: [PATCH] tu: TU_FLUSH_HACK to find the cache A8XX leaves stale

Styx: Blades of Greed (UE 5.6, vkd3d-proton 0bb64c56, Adreno 840)
renders shattered geometry on its second level unless TU_DEBUG=flushall
is set. flushall cleans and invalidates every cache at every draw and
dispatch, which is too slow to keep. TU_FLUSH_HACK applies only parts of
it, so the missing flush can be found and fixed properly:

  TU_FLUSH_HACK=bindless   bindless descriptor invalidate
  TU_FLUSH_HACK=uche       UCHE clean + invalidate
  TU_FLUSH_HACK=ccu        CCU color/depth clean + invalidate
  TU_FLUSH_HACK=cche       CCHE invalidate
  TU_FLUSH_HACK=wait       CP_WAIT_MEM_WRITES + CP_WAIT_FOR_ME
  TU_FLUSH_HACK=all        everything flushall does
  TU_FLUSH_HACK=barrier    full clean + invalidate at pipeline barriers only

Items can be combined with commas. Unset, nothing changes.
---
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ea1cecd..f07dba7 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -354,6 +354,57 @@ tu_emit_rt_workaround(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
    tu_cs_emit(cs, A6XX_CP_SET_MARKER_0_RT_WA_END);
 }
 
+/* WinNative: TU_FLUSH_HACK=<list> adds parts of TU_DEBUG=flushall to every
+ * draw and dispatch, to find which cache A8XX fails to keep coherent:
+ *   bindless  bindless descriptor invalidate
+ *   uche      UCHE (L2) clean + invalidate
+ *   ccu       CCU color/depth clean + invalidate
+ *   cche      CCHE invalidate
+ *   wait      CP_WAIT_MEM_WRITES + CP_WAIT_FOR_ME
+ *   all       everything flushall does
+ *   barrier   full clean + invalidate at every pipeline barrier only
+ */
+#define TU_FLUSH_HACK_BARRIER (1u << 31)
+static uint32_t
+tu_flush_hack_parse(void)
+{
+   uint32_t m = 0;
+   const char *s = getenv("TU_FLUSH_HACK");
+   if (!s)
+      return 0;
+   if (strstr(s, "bindless"))
+      m |= TU_CMD_FLAG_BINDLESS_DESCRIPTOR_INVALIDATE;
+   if (strstr(s, "uche"))
+      m |= TU_CMD_FLAG_CACHE_CLEAN | TU_CMD_FLAG_CACHE_INVALIDATE;
+   if (strstr(s, "ccu"))
+      m |= TU_CMD_FLAG_CCU_CLEAN_COLOR | TU_CMD_FLAG_CCU_CLEAN_DEPTH |
+           TU_CMD_FLAG_CCU_INVALIDATE_COLOR | TU_CMD_FLAG_CCU_INVALIDATE_DEPTH;
+   if (strstr(s, "cche"))
+      m |= TU_CMD_FLAG_CCHE_INVALIDATE;
+   if (strstr(s, "wait"))
+      m |= TU_CMD_FLAG_WAIT_MEM_WRITES | TU_CMD_FLAG_WAIT_FOR_ME;
+   if (strstr(s, "all"))
+      m |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+   if (strstr(s, "barrier"))
+      m |= TU_FLUSH_HACK_BARRIER;
+   return m;
+}
+
+static uint32_t
+tu_flush_hack_mask(void)
+{
+   /* Function-local static: initialised once, thread-safe in C++11. */
+   static const uint32_t mask = tu_flush_hack_parse();
+   return mask;
+}
+
+/* Flush bits added to every draw/dispatch flush point. */
+static inline uint32_t
+tu_flush_hack_bits(void)
+{
+   return tu_flush_hack_mask() & ~TU_FLUSH_HACK_BARRIER;
+}
+
 template <chip CHIP>
 static void
 tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
@@ -366,6 +417,8 @@ tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
    if (TU_DEBUG(FLUSHALL))
       flushes |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
 
+   flushes |= (enum tu_cmd_flush_bits) tu_flush_hack_bits();
+
    if (TU_DEBUG(SYNCDRAW))
       flushes |= TU_CMD_FLAG_WAIT_MEM_WRITES |
                  TU_CMD_FLAG_WAIT_FOR_IDLE |
@@ -629,7 +682,7 @@ void
 tu_emit_cache_flush_renderpass(struct tu_cmd_buffer *cmd_buffer)
 {
    if (!cmd_buffer->state.renderpass_cache.flush_bits &&
-       likely(!tu_env.debug))
+       likely(!tu_env.debug) && likely(!tu_flush_hack_bits()))
       return;
 
    struct tu_cs *cs = &cmd_buffer->draw_cs;
@@ -10966,6 +11019,9 @@ tu_barrier(struct tu_cmd_buffer *cmd,
 
    TU_CALLX(cmd->device, tu_flush_for_access)(cache, src_flags, dst_flags);
 
+   if (unlikely(tu_flush_hack_mask() & TU_FLUSH_HACK_BARRIER))
+      cache->flush_bits |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+
    if (!no_sync) {
       enum tu_stage src_stage = vk2tu_src_stage(cmd->device, srcStage);
       enum tu_stage dst_stage = vk2tu_dst_stage(cmd->device, dstStage);
