From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: durunduk <drebdebian@gmail.com>
Date: Mon, 19 Oct 2026 02:40:00 +0300
Subject: [PATCH] tu: Wait for CP memory writes at pipeline barriers on A8XX

Styx: Blades of Greed (UE 5.6, vkd3d-proton 0bb64c56, Adreno 840)
renders shattered geometry on its second level. Found with the
TU_FLUSH_HACK switch below: TU_DEBUG=flushall fixes it, a full flush at
pipeline barriers only fixes it, and CP_WAIT_MEM_WRITES + CP_WAIT_FOR_ME
alone fix it, while UCHE/CCU/CCHE/bindless invalidation alone do not.
A8XX dropped implicit CP waits that earlier GPUs had, so emit both at
every pipeline barrier on A8XX. They are cheap compared to cache flushes.

TU_FLUSH_HACK=<items> overrides the default (comma separated):
  barrier | draw              where to apply (default: barrier)
  bindless, uche, ccu, cche, wait, wait_mem, wait_me, all
                              what to apply (default: everything)
  none                        upstream behaviour
---
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ea1cecd..9ace00a 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -354,6 +354,111 @@ tu_emit_rt_workaround(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
    tu_cs_emit(cs, A6XX_CP_SET_MARKER_0_RT_WA_END);
 }
 
+/* WinNative: on A8XX a pipeline barrier does not always make the CP wait
+ * for earlier memory writes. Styx: Blades of Greed (UE 5.6, vkd3d-proton,
+ * Adreno 840) renders shattered geometry on its second level; flushing every
+ * cache at each barrier fixes it, and so do CP_WAIT_MEM_WRITES +
+ * CP_WAIT_FOR_ME alone. A8XX dropped the implicit waits earlier GPUs had
+ * (see tu_flush_for_stage), so A8XX emits both at every barrier by default.
+ * They are cheap compared to cache flushes.
+ *
+ * TU_FLUSH_HACK=<items> overrides the default (comma separated):
+ *   barrier   apply at pipeline barriers (implied when only parts are given)
+ *   draw      apply at every draw and dispatch instead (like flushall)
+ *   bindless, uche, ccu, cche, wait, wait_mem, wait_me
+ *             parts to apply; nothing named means all of flushall
+ *   none      no extra flushes, upstream behaviour
+ */
+struct tu_flush_hack {
+   bool set;          /* TU_FLUSH_HACK given */
+   bool at_barrier;
+   bool at_draw;
+   uint32_t bits;
+};
+
+static struct tu_flush_hack
+tu_flush_hack_parse(void)
+{
+   struct tu_flush_hack h = {};
+   const char *env = getenv("TU_FLUSH_HACK");
+   if (!env || !*env)
+      return h;
+   h.set = true;
+
+   char buf[256];
+   snprintf(buf, sizeof(buf), "%s", env);
+   bool named_parts = false;
+   for (char *save = NULL, *tok = strtok_r(buf, ", ", &save); tok;
+        tok = strtok_r(NULL, ", ", &save)) {
+      uint32_t part = 0;
+      if (!strcmp(tok, "none")) {
+         h.at_barrier = h.at_draw = false;
+         h.bits = 0;
+         return h;
+      } else if (!strcmp(tok, "barrier")) {
+         h.at_barrier = true;
+      } else if (!strcmp(tok, "draw")) {
+         h.at_draw = true;
+      } else if (!strcmp(tok, "all")) {
+         h.at_draw = true;
+         part = TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+      } else if (!strcmp(tok, "bindless")) {
+         part = TU_CMD_FLAG_BINDLESS_DESCRIPTOR_INVALIDATE;
+      } else if (!strcmp(tok, "uche")) {
+         part = TU_CMD_FLAG_CACHE_CLEAN | TU_CMD_FLAG_CACHE_INVALIDATE;
+      } else if (!strcmp(tok, "ccu")) {
+         part = TU_CMD_FLAG_CCU_CLEAN_COLOR | TU_CMD_FLAG_CCU_CLEAN_DEPTH |
+                TU_CMD_FLAG_CCU_INVALIDATE_COLOR |
+                TU_CMD_FLAG_CCU_INVALIDATE_DEPTH;
+      } else if (!strcmp(tok, "cche")) {
+         part = TU_CMD_FLAG_CCHE_INVALIDATE;
+      } else if (!strcmp(tok, "wait")) {
+         part = TU_CMD_FLAG_WAIT_MEM_WRITES | TU_CMD_FLAG_WAIT_FOR_ME;
+      } else if (!strcmp(tok, "wait_mem")) {
+         part = TU_CMD_FLAG_WAIT_MEM_WRITES;
+      } else if (!strcmp(tok, "wait_me")) {
+         part = TU_CMD_FLAG_WAIT_FOR_ME;
+      }
+      if (part) {
+         h.bits |= part;
+         named_parts = true;
+      }
+   }
+   if (!named_parts)
+      h.bits = TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+   if (!h.at_barrier && !h.at_draw)
+      h.at_barrier = true;
+   return h;
+}
+
+static const struct tu_flush_hack &
+tu_flush_hack_get(void)
+{
+   /* Function-local static: initialised once, thread-safe in C++11. */
+   static const struct tu_flush_hack h = tu_flush_hack_parse();
+   return h;
+}
+
+/* Extra flush bits for every draw/dispatch flush point. */
+static inline uint32_t
+tu_flush_hack_draw_bits(void)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   return h.at_draw ? h.bits : 0;
+}
+
+/* Extra flush bits for a pipeline barrier. */
+static inline uint32_t
+tu_flush_hack_barrier_bits(const struct tu_cmd_buffer *cmd)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   if (h.set)
+      return h.at_barrier ? h.bits : 0;
+   if (cmd->device->physical_device->info->chip >= A8XX)
+      return TU_CMD_FLAG_WAIT_MEM_WRITES | TU_CMD_FLAG_WAIT_FOR_ME;
+   return 0;
+}
+
 template <chip CHIP>
 static void
 tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
@@ -366,6 +471,8 @@ tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
    if (TU_DEBUG(FLUSHALL))
       flushes |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
 
+   flushes |= (enum tu_cmd_flush_bits) tu_flush_hack_draw_bits();
+
    if (TU_DEBUG(SYNCDRAW))
       flushes |= TU_CMD_FLAG_WAIT_MEM_WRITES |
                  TU_CMD_FLAG_WAIT_FOR_IDLE |
@@ -629,7 +736,7 @@ void
 tu_emit_cache_flush_renderpass(struct tu_cmd_buffer *cmd_buffer)
 {
    if (!cmd_buffer->state.renderpass_cache.flush_bits &&
-       likely(!tu_env.debug))
+       likely(!tu_env.debug) && likely(!tu_flush_hack_draw_bits()))
       return;
 
    struct tu_cs *cs = &cmd_buffer->draw_cs;
@@ -10966,6 +11073,9 @@ tu_barrier(struct tu_cmd_buffer *cmd,
 
    TU_CALLX(cmd->device, tu_flush_for_access)(cache, src_flags, dst_flags);
 
+   cache->flush_bits |=
+      (enum tu_cmd_flush_bits) tu_flush_hack_barrier_bits(cmd);
+
    if (!no_sync) {
       enum tu_stage src_stage = vk2tu_src_stage(cmd->device, srcStage);
       enum tu_stage dst_stage = vk2tu_dst_stage(cmd->device, dstStage);
