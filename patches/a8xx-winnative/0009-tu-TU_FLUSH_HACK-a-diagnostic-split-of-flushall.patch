From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: durunduk <drebdebian@gmail.com>
Date: Mon, 19 Oct 2026 02:40:00 +0300
Subject: [PATCH] tu: TU_FLUSH_HACK, a diagnostic split of TU_DEBUG=flushall

Styx: Blades of Greed (UE 5.6, vkd3d-proton 0bb64c56, Adreno 840)
renders shattered geometry on its second level. Found with the
TU_FLUSH_HACK switch below: TU_DEBUG=flushall fixes it, a full flush at
pipeline barriers only fixes it, and CP_WAIT_MEM_WRITES + CP_WAIT_FOR_ME
alone fix it, while UCHE/CCU/CCHE/bindless invalidation alone do not.
Bisecting further with the barrier categories below found the missing
CP_WAIT_FOR_ME before vertex/index fetch (fixed in 0010). This patch only
keeps the switch for diagnosing similar problems; unset, it does nothing.

TU_FLUSH_HACK=<items> (comma separated):
  barrier | draw              where to apply (default: barrier)
  bindless, uche, ccu, cche, wait, wait_mem, wait_me, all
                              what to apply (default: everything)
  dst_cp, dst_vtx, dst_late, src_compute, src_xfer, src_gfx, src_all,
  in_rp, out_rp               only barriers in one of these categories
  none                        upstream behaviour
e.g. TU_FLUSH_HACK=wait,dst_cp waits only before CP reads (indirect args).
---
diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index ea1cecd..ad3bd17 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -354,6 +354,152 @@ tu_emit_rt_workaround(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
    tu_cs_emit(cs, A6XX_CP_SET_MARKER_0_RT_WA_END);
 }
 
+/* WinNative: on A8XX a pipeline barrier does not always make the CP wait
+ * for earlier memory writes. Styx: Blades of Greed (UE 5.6, vkd3d-proton,
+ * Adreno 840) renders shattered geometry on its second level; flushing every
+ * cache at each barrier fixes it, and so do CP_WAIT_MEM_WRITES +
+ * CP_WAIT_FOR_ME alone. Bisecting with the categories below showed the
+ * missing CP_WAIT_FOR_ME before vertex/index fetch; tu_flush_for_stage()
+ * now emits it (0010), so this switch only adds flushes when set.
+ *
+ * TU_FLUSH_HACK=<items> (diagnostic, comma separated):
+ *   barrier   apply at pipeline barriers (implied when only parts are given)
+ *   dst_cp, dst_vtx, dst_late, src_compute, src_xfer, src_gfx, src_all,
+ *   in_rp, out_rp
+ *             only at barriers in at least one of these categories
+ *   draw      apply at every draw and dispatch instead (like flushall)
+ *   bindless, uche, ccu, cche, wait, wait_mem, wait_me
+ *             parts to apply; nothing named means all of flushall
+ *   none      no extra flushes, upstream behaviour
+ */
+struct tu_flush_hack {
+   bool set;          /* TU_FLUSH_HACK given */
+   bool at_barrier;
+   bool at_draw;
+   uint32_t bits;
+   uint32_t filters;  /* TU_BARRIER_CAT_*: only barriers in these */
+};
+
+/* Barrier categories for narrowing down which barrier needs the waits. */
+enum {
+   TU_BARRIER_CAT_DST_CP      = 1u << 0, /* read next by the CP (indirect) */
+   TU_BARRIER_CAT_DST_VTX     = 1u << 1, /* read next by vertex/index fetch */
+   TU_BARRIER_CAT_DST_LATE    = 1u << 2, /* read next by shaders/later */
+   TU_BARRIER_CAT_SRC_COMPUTE = 1u << 3, /* written by compute */
+   TU_BARRIER_CAT_SRC_XFER    = 1u << 4, /* written by copy/clear/blit */
+   TU_BARRIER_CAT_SRC_GFX     = 1u << 5, /* written by graphics */
+   TU_BARRIER_CAT_SRC_ALL     = 1u << 6, /* src ALL_COMMANDS */
+   TU_BARRIER_CAT_IN_RP       = 1u << 7, /* inside a render pass */
+   TU_BARRIER_CAT_OUT_RP      = 1u << 8, /* outside a render pass */
+};
+
+static struct tu_flush_hack
+tu_flush_hack_parse(void)
+{
+   struct tu_flush_hack h = {};
+   const char *env = getenv("TU_FLUSH_HACK");
+   if (!env || !*env)
+      return h;
+   h.set = true;
+
+   char buf[256];
+   snprintf(buf, sizeof(buf), "%s", env);
+   bool named_parts = false;
+   for (char *save = NULL, *tok = strtok_r(buf, ", ", &save); tok;
+        tok = strtok_r(NULL, ", ", &save)) {
+      uint32_t part = 0;
+      if (!strcmp(tok, "none")) {
+         h.at_barrier = h.at_draw = false;
+         h.bits = 0;
+         return h;
+      } else if (!strcmp(tok, "barrier")) {
+         h.at_barrier = true;
+      } else if (!strcmp(tok, "draw")) {
+         h.at_draw = true;
+      } else if (!strcmp(tok, "all")) {
+         h.at_draw = true;
+         part = TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+      } else if (!strcmp(tok, "bindless")) {
+         part = TU_CMD_FLAG_BINDLESS_DESCRIPTOR_INVALIDATE;
+      } else if (!strcmp(tok, "uche")) {
+         part = TU_CMD_FLAG_CACHE_CLEAN | TU_CMD_FLAG_CACHE_INVALIDATE;
+      } else if (!strcmp(tok, "ccu")) {
+         part = TU_CMD_FLAG_CCU_CLEAN_COLOR | TU_CMD_FLAG_CCU_CLEAN_DEPTH |
+                TU_CMD_FLAG_CCU_INVALIDATE_COLOR |
+                TU_CMD_FLAG_CCU_INVALIDATE_DEPTH;
+      } else if (!strcmp(tok, "cche")) {
+         part = TU_CMD_FLAG_CCHE_INVALIDATE;
+      } else if (!strcmp(tok, "wait")) {
+         part = TU_CMD_FLAG_WAIT_MEM_WRITES | TU_CMD_FLAG_WAIT_FOR_ME;
+      } else if (!strcmp(tok, "wait_mem")) {
+         part = TU_CMD_FLAG_WAIT_MEM_WRITES;
+      } else if (!strcmp(tok, "wait_me")) {
+         part = TU_CMD_FLAG_WAIT_FOR_ME;
+      } else if (!strcmp(tok, "dst_cp")) {
+         h.filters |= TU_BARRIER_CAT_DST_CP;
+      } else if (!strcmp(tok, "dst_vtx")) {
+         h.filters |= TU_BARRIER_CAT_DST_VTX;
+      } else if (!strcmp(tok, "dst_late")) {
+         h.filters |= TU_BARRIER_CAT_DST_LATE;
+      } else if (!strcmp(tok, "src_compute")) {
+         h.filters |= TU_BARRIER_CAT_SRC_COMPUTE;
+      } else if (!strcmp(tok, "src_xfer")) {
+         h.filters |= TU_BARRIER_CAT_SRC_XFER;
+      } else if (!strcmp(tok, "src_gfx")) {
+         h.filters |= TU_BARRIER_CAT_SRC_GFX;
+      } else if (!strcmp(tok, "src_all")) {
+         h.filters |= TU_BARRIER_CAT_SRC_ALL;
+      } else if (!strcmp(tok, "in_rp")) {
+         h.filters |= TU_BARRIER_CAT_IN_RP;
+      } else if (!strcmp(tok, "out_rp")) {
+         h.filters |= TU_BARRIER_CAT_OUT_RP;
+      }
+      if (part) {
+         h.bits |= part;
+         named_parts = true;
+      }
+   }
+   if (!named_parts)
+      h.bits = TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
+   if (!h.at_barrier && !h.at_draw)
+      h.at_barrier = true;
+   return h;
+}
+
+static const struct tu_flush_hack &
+tu_flush_hack_get(void)
+{
+   /* Function-local static: initialised once, thread-safe in C++11. */
+   static const struct tu_flush_hack h = tu_flush_hack_parse();
+   return h;
+}
+
+/* Extra flush bits for every draw/dispatch flush point. */
+static inline uint32_t
+tu_flush_hack_draw_bits(void)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   return h.at_draw ? h.bits : 0;
+}
+
+/* Extra flush bits for a pipeline barrier. */
+static inline uint32_t
+tu_flush_hack_barrier_bits(const struct tu_cmd_buffer *cmd, uint32_t cats)
+{
+   const struct tu_flush_hack &h = tu_flush_hack_get();
+   if (h.set) {
+      if (!h.at_barrier)
+         return 0;
+      /* With category filters, a barrier must match at least one. */
+      if (h.filters && !(h.filters & cats))
+         return 0;
+      return h.bits;
+   }
+   /* Without TU_FLUSH_HACK nothing is added: the actual fix lives in
+    * tu_flush_for_stage() (0010). */
+   return 0;
+}
+
 template <chip CHIP>
 static void
 tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
@@ -366,6 +512,8 @@ tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
    if (TU_DEBUG(FLUSHALL))
       flushes |= TU_CMD_FLAG_ALL_CLEAN | TU_CMD_FLAG_ALL_INVALIDATE;
 
+   flushes |= (enum tu_cmd_flush_bits) tu_flush_hack_draw_bits();
+
    if (TU_DEBUG(SYNCDRAW))
       flushes |= TU_CMD_FLAG_WAIT_MEM_WRITES |
                  TU_CMD_FLAG_WAIT_FOR_IDLE |
@@ -629,7 +777,7 @@ void
 tu_emit_cache_flush_renderpass(struct tu_cmd_buffer *cmd_buffer)
 {
    if (!cmd_buffer->state.renderpass_cache.flush_bits &&
-       likely(!tu_env.debug))
+       likely(!tu_env.debug) && likely(!tu_flush_hack_draw_bits()))
       return;
 
    struct tu_cs *cs = &cmd_buffer->draw_cs;
@@ -10966,6 +11114,35 @@ tu_barrier(struct tu_cmd_buffer *cmd,
 
    TU_CALLX(cmd->device, tu_flush_for_access)(cache, src_flags, dst_flags);
 
+   uint32_t cats = 0;
+   switch (vk2tu_dst_stage(cmd->device, dstStage)) {
+   case TU_STAGE_BV_CP: cats |= TU_BARRIER_CAT_DST_CP; break;
+   case TU_STAGE_BV:    cats |= TU_BARRIER_CAT_DST_VTX; break;
+   default:             cats |= TU_BARRIER_CAT_DST_LATE; break;
+   }
+   if (srcStage & (VK_PIPELINE_STAGE_2_COMPUTE_SHADER_BIT))
+      cats |= TU_BARRIER_CAT_SRC_COMPUTE;
+   if (srcStage & (VK_PIPELINE_STAGE_2_ALL_TRANSFER_BIT |
+                   VK_PIPELINE_STAGE_2_COPY_BIT |
+                   VK_PIPELINE_STAGE_2_RESOLVE_BIT |
+                   VK_PIPELINE_STAGE_2_BLIT_BIT |
+                   VK_PIPELINE_STAGE_2_CLEAR_BIT))
+      cats |= TU_BARRIER_CAT_SRC_XFER;
+   if (srcStage & (VK_PIPELINE_STAGE_2_ALL_GRAPHICS_BIT |
+                   VK_PIPELINE_STAGE_2_VERTEX_SHADER_BIT |
+                   VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT |
+                   VK_PIPELINE_STAGE_2_EARLY_FRAGMENT_TESTS_BIT |
+                   VK_PIPELINE_STAGE_2_LATE_FRAGMENT_TESTS_BIT |
+                   VK_PIPELINE_STAGE_2_COLOR_ATTACHMENT_OUTPUT_BIT |
+                   VK_PIPELINE_STAGE_2_PRE_RASTERIZATION_SHADERS_BIT))
+      cats |= TU_BARRIER_CAT_SRC_GFX;
+   if (srcStage & VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT)
+      cats |= TU_BARRIER_CAT_SRC_ALL;
+   cats |= cmd->state.pass ? TU_BARRIER_CAT_IN_RP : TU_BARRIER_CAT_OUT_RP;
+
+   cache->flush_bits |=
+      (enum tu_cmd_flush_bits) tu_flush_hack_barrier_bits(cmd, cats);
+
    if (!no_sync) {
       enum tu_stage src_stage = vk2tu_src_stage(cmd->device, srcStage);
       enum tu_stage dst_stage = vk2tu_dst_stage(cmd->device, dstStage);
